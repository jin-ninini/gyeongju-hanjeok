# backend/.env.example
# 이 파일을 복사해 backend/.env 로 저장한 뒤 값을 채우세요.
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env

APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
DATABASE_URL=

# 공공데이터포털 (한국관광공사 / 기상청) 서비스키
PUBLIC_DATA_SERVICE_KEY=
KMA_SERVICE_KEY=

# Kakao / OpenAI / Naver / YouTube
KAKAO_REST_API_KEY=
OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=

# 공공 API 베이스 URL
TOUR_API_BASE_URL=
CONGESTION_API_BASE_URL=
RELATED_API_BASE_URL=
HUB_API_BASE_URL=
PHOTO_API_BASE_URL=
KAKAO_NAVI_BASE_URL=
KAKAO_WALKING_BASE_URL=
KMA_BASE_URL=

# OpenAI 설정
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# 관광공사 API 호출 파라미터
MOBILE_OS=
MOBILE_APP=
TOUR_AREA_CODE=
TOUR_SIGUNGU_CODE=
ADMIN_AREA_CODE=
ADMIN_SIGUNGU_CODE=

# 기능 토글 / 알고리즘 파라미터
ENABLE_KAKAO_WALKING_API=false
KAKAO_SERVICE_NAME=
CONGESTION_THRESHOLD=
REPLACEMENT_CONGESTION_THRESHOLD=
MAX_CANDIDATE_PLACES=
MAX_COURSE_PLACES=
DEFAULT_STAY_MINUTES=
NSGA_POPULATION_SIZE=
NSGA_GENERATIONS=
HTTP_TIMEOUT_SECONDS=
CACHE_TTL_SECONDS=

# 관광지 DB / RAG 동기화 스케줄
DAILY_SYNC_ENABLED=false
DAILY_SYNC_HOUR=4

# 약관/동의 버전
TERMS_VERSION=
PRIVACY_VERSION=
LOCATION_CONSENT_VERSION=
NOTIFICATION_CONSENT_VERSION=

# 초대 링크
PUBLIC_INVITE_BASE_URL=
APP_DOWNLOAD_URL=
FRIEND_INVITE_HOURS=168

# 푸시 알림 (Firebase Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# 비밀번호 찾기 이메일 발송 - Gmail API (Railway 등 SMTP 차단 환경 대응)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=경주한적

# 비밀번호 찾기 이메일 발송 - SMTP (대체 경로, 선택)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=경주한적

PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=60

# backend/.env.example
# 이 파일을 복사해 backend/.env 로 저장한 뒤 값을 채우세요.
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# 주석(#) 처리된 항목은 코드 기본값이 적용됩니다. 바꿀 때만 주석을 풀어 값을 넣으세요.
# 빈 값(KEY=)으로 두면 기본값을 덮어써서 서버가 실행되지 않거나 연동이 끊길 수 있습니다.

# 서버
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# CORS_ORIGINS=["*"]
# 로컬 기본값은 SQLite입니다. PostgreSQL 사용 시 주석을 풀고 URL을 넣으세요.
# DATABASE_URL=sqlite:///./data/gyeongju_hanjeok.db

# 공공데이터포털 (한국관광공사 / 기상청) 서비스키
PUBLIC_DATA_SERVICE_KEY=
KMA_SERVICE_KEY=

# Kakao / OpenAI / Naver / YouTube
KAKAO_REST_API_KEY=
OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=

# 공공 API 베이스 URL
# TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# CONGESTION_API_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService
# RELATED_API_BASE_URL=https://apis.data.go.kr/B551011/TarRlteTarService1
# HUB_API_BASE_URL=https://apis.data.go.kr/B551011/LocgoHubTarService1
# PHOTO_API_BASE_URL=https://apis.data.go.kr/B551011/PhotoGalleryService1
# KAKAO_NAVI_BASE_URL=https://apis-navi.kakaomobility.com
# KAKAO_WALKING_BASE_URL=https://apis-navi.kakaomobility.com/affiliate/walking
# KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0

# OpenAI 설정
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 관광공사 API 호출 파라미터
# MOBILE_OS=ETC
# MOBILE_APP=GyeongjuHanjeok
# TOUR_AREA_CODE=35
# TOUR_SIGUNGU_CODE=2
# ADMIN_AREA_CODE=47
# ADMIN_SIGUNGU_CODE=47130

# 기능 토글 / 알고리즘 파라미터
ENABLE_KAKAO_WALKING_API=false
# KAKAO_SERVICE_NAME=gyeongju-hanjeok
# CONGESTION_THRESHOLD=80
# REPLACEMENT_CONGESTION_THRESHOLD=50
# MAX_CANDIDATE_PLACES=35
# MAX_COURSE_PLACES=6
# DEFAULT_STAY_MINUTES=45
# NSGA_POPULATION_SIZE=60
# NSGA_GENERATIONS=35
# HTTP_TIMEOUT_SECONDS=20
# CACHE_TTL_SECONDS=600

# 관광지 DB / RAG 동기화 스케줄
DAILY_SYNC_ENABLED=false
DAILY_SYNC_HOUR=4

# 약관/동의 버전
# TERMS_VERSION=2026-09-14
# PRIVACY_VERSION=2026-09-14
# LOCATION_CONSENT_VERSION=2026-09-14
# NOTIFICATION_CONSENT_VERSION=2026-09-21

# 초대 링크
PUBLIC_INVITE_BASE_URL=
APP_DOWNLOAD_URL=
FRIEND_INVITE_HOURS=168

# 푸시 알림 (Firebase Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# 비밀번호 찾기 이메일 발송 - Gmail API (Railway 등 SMTP 차단 환경 대응)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# 발신 주소. 비워 두면 코드 기본값이 쓰이므로 본인 주소를 넣으세요.
# EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=경주한적

# 비밀번호 찾기 이메일 발송 - SMTP (대체 경로, 선택)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=경주한적

PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=60

# frontend/.env.example
# 이 파일을 복사해 frontend/.env 로 저장한 뒤 값을 채우세요.
#   cp .env.example .env
#
# 주석(#) 처리된 항목은 코드 기본값이 적용됩니다.

# live: 실제 백엔드 호출 / 그 외 값(preview 등): 기기 안의 샘플 데이터로만 동작
APP_MODE=live
# Android 에뮬레이터: http://10.0.2.2:8000 / 실기기: http://<PC의 LAN IP>:8000
BACKEND_BASE_URL=http://10.0.2.2:8000
BACKEND_CONTRACT=snake_flat

KAKAO_JAVASCRIPT_KEY=
KAKAO_NATIVE_APP_KEY=
# 지도 WebView의 baseUrl. Kakao Developers에 등록한 사이트 도메인과 같아야 합니다.
# KAKAO_MAP_BASE_URL=https://localhost

# GPS를 쓰기 전 지도 기본 중심 (경주)
# DEFAULT_LATITUDE=35.8562
# DEFAULT_LONGITUDE=129.2247
# CONGESTION_REFRESH_MINUTES=5
